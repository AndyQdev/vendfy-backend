# Copia este archivo a deploy/api.env EN EL SERVIDOR y rellena los valores.
# Nunca lo subas al repositorio.
#
# ⚠ SIN COMILLAS. Docker `--env-file` NO las interpreta: si escribes
#   SUPABASE_URL="https://x.supabase.co"
# el valor incluye las comillas y la app falla con "Invalid supabaseUrl".
# Tu .env local sí las tiene (ahí las lee dotenv, que sí las quita), así que
# no lo copies tal cual: quítalas al pasar los valores.

APP_NAME=vendfy-backend
APP_PROD=true
PORT=3001

# --- Base de datos (Supabase, us-east-2) -------------------------------
DATABASE_URL="postgresql://postgres:<password>@<host>:6543/postgres"

# --- Seguridad ---------------------------------------------------------
# CAMBIAR: hoy en local están como 'secret'. Al rotarlos se cierran todas
# las sesiones abiertas, así que hazlo antes de tener usuarios reales.
JWT_AUTH=<cadena-larga-aleatoria>
JWT_RECOVERY=<otra-cadena-larga-aleatoria>
HASH_SALT=10

# --- URLs públicas -----------------------------------------------------
# De aquí salen el webhook que se registra en Kapso y los links de los
# botones de los templates de WhatsApp.
# Los comentarios van en su PROPIA línea: Docker no entiende comentarios
# al final de un valor, se los traga como parte del texto.
API_PUBLIC_URL=https://api.vendfy.shop
# Tienda pública (Vercel)
WEB_CLIENT_URL=https://compras.vendfy.shop
# Panel de administración (Vercel)
APP_URL=https://admin.vendfy.shop

# --- Supabase Storage --------------------------------------------------
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# --- WhatsApp (Kapso) --------------------------------------------------
KAPSO_API_KEY=<api-key>
KAPSO_BASE_URL=https://api.kapso.ai

# --- Agente IA ---------------------------------------------------------
AGENT_DEFAULT_PROVIDER=gemini
AGENT_MAX_ITERATIONS=6
# Gemini por Vertex AI (modo express): la clave de Vertex y su dirección.
# Sin GEMINI_BASE_URL se usa Google AI (generativelanguage) con una clave de AI Studio.
GEMINI_API_KEY=<key>
GEMINI_BASE_URL=https://aiplatform.googleapis.com/v1/publishers/google
# Chirp 3 HD (Cloud Text-to-Speech) no acepta claves de Vertex: una clave de
# Google Cloud con esa API habilitada. Sin ella, usa GEMINI_API_KEY.
VOZ_TTS_API_KEY=<key>
AGENT_GEMINI_MODEL=gemini-3.5-flash
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# --- MCP storefronts ---------------------------------------------------
MCP_AUTH_MODE=oidc
MCP_PUBLIC_URL=https://api.vendfy.shop
MCP_API_BASE_URL=https://api.vendfy.shop/api
# MCP_OAUTH_ISSUER=https://<tu-proyecto>.authkit.app
# MCP_OAUTH_JWKS_URL=https://<tu-proyecto>.authkit.app/oauth2/jwks
# MCP_OAUTH_AUDIENCE=https://api.vendfy.shop/mcp
# WORKOS_API_KEY=
