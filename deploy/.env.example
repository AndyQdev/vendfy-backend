# Copia a deploy/.env en el servidor.
#
# Variables de BUILD de los frontends (se hornean en el bundle: cambiarlas
# obliga a reconstruir, no basta con reiniciar).
ADMIN_API_URL=https://api.vendfy.shop
ADMIN_PUBLIC_URL=https://compras.vendfy.shop
WEB_PUBLIC_API_URL=https://api.vendfy.shop/api
GOOGLE_MAPS_API_KEY=
REVALIDATE_SECRET=

#
# Opcional pero MUY recomendable: conexión DIRECTA a Postgres (puerto 5432,
# no el pooler 6543). Si la pones, deploy.sh saca un dump antes de cada
# despliegue y aborta si el respaldo falla. Mientras TypeORM siga con
# synchronize activo, esto es lo único que te separa de perder datos.
#
# DIRECT_DATABASE_URL="postgresql://postgres:<password>@<host>:5432/postgres"
