APP_NAME="synth-backend"
APP_PROD="false"
APP_VERSION="0.1.0"
PORT="3001"


APP_URL="http://localhost:3000"

# WhatsApp Server Configuration
WHATSAPP_SERVER_URL="http://localhost:3000"

# Supabase Database (usar esta URL para conectar a Supabase)
# Ve a Supabase Dashboard > Project Settings > Database > Connection string > URI
DATABASE_URL="postgresql://postgres:<password>@<host>:5432/postgres"

# Local Database (descomentar para usar local, y comentar DATABASE_URL)
#DB_CONNECTION="postgres"
#DB_HOST="localhost"
#DB_PORT="5432"
#DB_DATABASE="ecommerce"
#DB_USERNAME="ecom_user"
#DB_PASSWORD=<tu-db-password>

HASH_SALT="10"
JWT_AUTH='secret'
JWT_RECOVERY='secret'


OPENAI_API_KEY=<tu-openai-api-key>

# WhatsApp Server Configuration
WHATSAPP_API_URL="http://localhost:3030"
# Shared secret para el webhook entrante /api/chat/webhook/vendfy
# Debe coincidir con VENDFY_WEBHOOK_SECRET del servidor de WhatsApp
VENDFY_WEBHOOK_SECRET=<tu-vendfy-webhook-secret>

# Kapso WhatsApp Business API
KAPSO_API_KEY=""
KAPSO_BASE_URL="https://api.kapso.ai"

# Supabase Configuration
SUPABASE_URL="https://szizdgqfmnbbjewavqtt.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=<tu-supabase-service-role-key>

META_APP_ID=1325684399467710
META_ACCESS_TOKEN=<tu-meta-access-token>
# META_ACCESS_TOKEN=<tu-meta-access-token>
# <valor>

# Cifrado en reposo de las credenciales de plataformas externas (Fase 1).
# Cualquier cadena larga y aleatoria: se deriva a 32 bytes con SHA-256.
# Si se cambia, las conexiones ya guardadas dejan de poder descifrarse.
INTEGRATIONS_ENC_KEY=

# --- Meta / Growth Hub (Fase 1) ---
# Identificadores de las configuraciones de "Inicio de sesion con Facebook
# para Empresas". Este login NO recibe una lista de permisos: recibe el id de
# una configuracion creada en el panel de la app.
# Eventos de conversion (whatsapp_business_manage_events)
META_LOGIN_CONFIG_EVENTS=
# Lectura y gestion de anuncios (ads_read, ads_management, business_management)
META_LOGIN_CONFIG_ADS=
# Version de la Graph API. Meta retira versiones cada ano.
META_GRAPH_VERSION=v23.0
